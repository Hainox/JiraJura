# Бутстрап-конфиг: используется ДО выпуска TLS-сертификата (нет файлов
# сертификата — блок "listen 443 ssl" не может стартовать). Обслуживает
# ACME-челлендж и, для удобства, само приложение по обычному HTTP на время
# первого запуска. Автоматически заменяется на полный TLS-конфиг скриптом
# deploy/scripts/issue-cert.sh после успешного выпуска сертификата — вручную
# редактировать не нужно.
server {
    listen 80;
    server_name ${DOMAIN};

    # см. комментарий про resolver в proxy.conf.template — тот же приём,
    # чтобы nginx не кэшировал IP api/frontend навсегда.
    resolver 127.0.0.11 valid=10s;

    # Синхронно с proxy.conf.template/MAX_PHOTO_SIZE_MB — без этого действует
    # дефолт nginx (1m), и любая попытка загрузить фото в этом бутстрап-окне
    # (до выпуска сертификата) молча получает 413, хотя приложение заявляет
    # лимит 20 МБ.
    client_max_body_size 25m;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /api/v1/ {
        set $api_upstream api:8000;
        # см. комментарий в proxy.conf.template — $request_uri обязателен
        # при переменной в хосте proxy_pass, иначе всегда шлётся "/api/v1/".
        proxy_pass http://$api_upstream$request_uri;
        proxy_set_header Host $host;
        # Без X-Real-IP бэкенд (_client_ip() в auth.py/feedback.py) видит
        # вместо реального адреса клиента внутренний IP nginx-контейнера —
        # IP-based lockout логина и rate-limit обращений становятся общими
        # на ВСЕХ, кто ходит через bootstrap-конфиг, а не персональными.
        # Тот же заголовок уже стоит в proxy.conf.template — здесь его не
        # хватало, раз этот конфиг активен только до выпуска сертификата.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        set $api_upstream api:8000;
        proxy_pass http://$api_upstream$request_uri;
    }

    location / {
        set $frontend_upstream frontend:80;
        proxy_pass http://$frontend_upstream;
        proxy_set_header Host $host;
    }
}
