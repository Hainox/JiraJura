# Полный TLS-конфиг. Устанавливается вместо http-only.conf.template
# скриптом deploy/scripts/issue-cert.sh сразу после успешного выпуска
# сертификата Let's Encrypt — вручную включать не нужно.
server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host:${HTTPS_PORT}$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    # Синхронно с MAX_PHOTO_SIZE_MB (20 МБ по умолчанию) + запас на заголовки.
    client_max_body_size 25m;

    # 127.0.0.11 — встроенный DNS докер-сети. Без него proxy_pass с
    # хардкодным хостом ("http://api:8000") резолвится ОДИН раз при
    # старте/reload nginx и кэшируется навсегда — при пересборке api/
    # frontend контейнер получает новый IP, а nginx продолжает стучаться
    # в старый ("Connection refused" → 502), пока proxy вручную не
    # перезапустят. С resolver + переменной в proxy_pass nginx резолвит
    # хост заново на каждый запрос (не чаще, чем раз в valid=10s).
    resolver 127.0.0.11 valid=10s;

    location /api/v1/ {
        set $api_upstream api:8000;
        # $request_uri (не "/api/v1/") — proxy_pass с переменной в хосте
        # отключает автоматическую подстановку "остатка пути" после
        # location, которую nginx обычно делает сам. Без этого сюда
        # всегда уходил бы буквально "/api/v1/" независимо от реального
        # пути запроса (напр. "/api/v1/auth/login" превращался в 404).
        proxy_pass http://$api_upstream$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        set $api_upstream api:8000;
        proxy_pass http://$api_upstream$request_uri;
    }

    location / {
        set $frontend_upstream frontend:80;
        proxy_pass http://$frontend_upstream;
        proxy_set_header Host $host;
    }
}
