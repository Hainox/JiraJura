# Бутстрап-конфиг: используется ДО выпуска TLS-сертификата (нет файлов
# сертификата — блок "listen 443 ssl" не может стартовать). Обслуживает
# ACME-челлендж и, для удобства, само приложение по обычному HTTP на время
# первого запуска. Автоматически заменяется на полный TLS-конфиг скриптом
# deploy/scripts/issue-cert.sh после успешного выпуска сертификата — вручную
# редактировать не нужно.
server {
    listen 80;
    server_name ${DOMAIN};

    # см. комментарий про resolver в proxy.conf.template — тот же приём,
    # чтобы nginx не кэшировал IP api/frontend навсегда.
    resolver 127.0.0.11 valid=10s;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /api/v1/ {
        set $api_upstream api:8000;
        # см. комментарий в proxy.conf.template — $request_uri обязателен
        # при переменной в хосте proxy_pass, иначе всегда шлётся "/api/v1/".
        proxy_pass http://$api_upstream$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        set $api_upstream api:8000;
        proxy_pass http://$api_upstream$request_uri;
    }

    location / {
        set $frontend_upstream frontend:80;
        proxy_pass http://$frontend_upstream;
        proxy_set_header Host $host;
    }
}
