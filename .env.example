# Продакшн-конфигурация docker-compose.prod.yml. Скопируйте в .env на
# сервере (НЕ коммитить .env — уже в .gitignore) и заполните реальными
# значениями. Генерация секретов:
#   openssl rand -hex 32   -> SECRET_KEY
#   openssl rand -hex 24   -> POSTGRES_PASSWORD

DOMAIN=journal.yuvibot2.xyz
CERTBOT_EMAIL=

SECRET_KEY=
POSTGRES_PASSWORD=

# Порты, на которых JiraJura слушает наружу — НЕ 80/443, те заняты
# nginx-контейнером телеграм-бота на этом сервере (yuvibotv2-nginx-https-1).
# На ВЫДЕЛЕННОМ сервере без соседей — HTTP_PORT=80, HTTPS_PORT=443, и
# сертификат выпускается/продлевается deploy/scripts/issue-cert-standalone.sh
# / renew-cert-standalone.sh (не issue-cert.sh/renew-cert.sh — те писаны
# под координацию с чужим nginx на порту 80) — BOT_COMPOSE_PROJECT/
# BOT_NGINX_SERVICE ниже в этом случае не нужны и не читаются.
HTTP_PORT=8080
HTTPS_PORT=8443

# Оставить пустым: фронтенд и бэкенд отдаются с одного origin через proxy.
VITE_API_URL=

# Имя compose-проекта и сервиса nginx у бота — нужны deploy/scripts/issue-cert.sh
# и renew-cert.sh, чтобы на несколько секунд освободить порт 80 для ACME-
# челленджа Let's Encrypt. Не меняйте, если у бота другое имя проекта.
BOT_COMPOSE_PROJECT=yuvibotv2
BOT_NGINX_SERVICE=nginx-https
