"""Тесты для auth router."""
import pytest
from unittest.mock import patch
from app.services.auth import hash_password


class TestLogin:
    async def test_login_success(self, client, admin_user):
        """Успешный логин с правильным паролем."""
        mock_session = client._transport.app.dependency_overrides[
            list(client._transport.app.dependency_overrides.keys())[0]
        ]
        # Настроим мок БД
        from app.database import get_db
        session = client._transport.app.dependency_overrides[get_db]  # noqa
        # Но проще через import из conftest
        from tests.conftest import mock_session, make_scalar_result

        admin_user.password_hash = hash_password("adminpass")
        mock_session.execute.return_value = make_scalar_result(admin_user)

        resp = await client.post("/api/v1/auth/login", json={
            "login": "admin", "password": "adminpass"
        })
        assert resp.status_code == 200
        data = resp.json()
        assert "access_token" in data
        assert data["user"]["login"] == "admin"
        assert data["user"]["role"] == "admin"

    async def test_login_wrong_password(self, client, admin_user):
        """Логин с неверным паролем — 401."""
        from tests.conftest import mock_session, make_scalar_result

        admin_user.password_hash = hash_password("correct")
        mock_session.execute.return_value = make_scalar_result(admin_user)

        resp = await client.post("/api/v1/auth/login", json={
            "login": "admin", "password": "wrong"
        })
        assert resp.status_code == 401

    async def test_login_nonexistent_user(self, client):
        """Логин несуществующего пользователя — 401."""
        from tests.conftest import mock_session, make_scalar_result
        mock_session.execute.return_value = make_scalar_result(None)

        resp = await client.post("/api/v1/auth/login", json={
            "login": "noone", "password": "nope"
        })
        assert resp.status_code == 401


class TestMe:
    async def test_me_unauthorized(self, client):
        """Без токена — 403 (FastAPI HTTPBearer)."""
        resp = await client.get("/api/v1/auth/me")
        assert resp.status_code == 403

    async def test_me_with_token(self, client, admin_user, auth_headers):
        """С токеном — 200, возвращает профиль."""
        from tests.conftest import mock_session, make_scalar_result
        mock_session.execute.return_value = make_scalar_result(admin_user)

        resp = await client.get("/api/v1/auth/me", headers=auth_headers)
        assert resp.status_code == 200
        assert resp.json()["login"] == "admin"


class TestUserManagement:
    async def test_list_users_admin(self, client, auth_headers):
        """Админ получает список пользователей."""
        from tests.conftest import mock_session, make_scalar_result
        from app.models import User

        u1 = User(id="u1", login="a", password_hash="h", full_name="A", role="inspector", is_active=True)
        u2 = User(id="u2", login="b", password_hash="h", full_name="B", role="reviewer", is_active=True)
        mock_session.execute.return_value = make_scalar_result([u1, u2])

        resp = await client.get("/api/v1/auth/users", headers=auth_headers)
        assert resp.status_code == 200
        data = resp.json()
        assert len(data) == 2

    async def test_list_users_forbidden_non_admin(self, client, inspector_user):
        """Не-админ не может получить список."""
        from app.services.auth import create_access_token
        token = create_access_token(str(inspector_user.id), inspector_user.role)
        headers = {"Authorization": f"Bearer {token}"}

        from tests.conftest import mock_session, make_scalar_result
        mock_session.execute.return_value = make_scalar_result(inspector_user)

        resp = await client.get("/api/v1/auth/users", headers=headers)
        assert resp.status_code == 403

    async def test_delete_user_cannot_self(self, client, admin_user, auth_headers):
        """Нельзя удалить самого себя."""
        from tests.conftest import mock_session, make_scalar_result
        mock_session.execute.return_value = make_scalar_result(admin_user)

        resp = await client.delete(
            f"/api/v1/auth/users/{admin_user.id}", headers=auth_headers
        )
        assert resp.status_code == 400

    async def test_delete_nonexistent_user(self, client, auth_headers):
        """Удаление несуществующего — 404."""
        from tests.conftest import mock_session, make_scalar_result
        # первый вызов: get_current_user находит админа
        # второй вызов: delete_user ищет цель
        mock_session.execute.side_effect = [
            make_scalar_result(None),  # getUser для токена не нужен — admin уже в токене
            make_scalar_result(None),  # ищем удаляемого
        ]
        # Проще: сделаем один вызов
        mock_session.execute.return_value = make_scalar_result(None)

        resp = await client.delete(
            "/api/v1/auth/users/00000000-0000-0000-0000-000000000000",
            headers=auth_headers,
        )
        assert resp.status_code == 404


class TestPasswordReset:
    async def test_reset_password_nonexistent(self, client, auth_headers):
        """Сброс пароля несуществующего — 404."""
        from tests.conftest import mock_session, make_scalar_result
        mock_session.execute.return_value = make_scalar_result(None)

        resp = await client.post(
            "/api/v1/auth/users/00000000-0000-0000-0000-000000000000/reset-password",
            headers=auth_headers,
        )
        assert resp.status_code == 404


class TestInvites:
    async def test_preview_invalid_token(self, client):
        """Недействительный токен — 404."""
