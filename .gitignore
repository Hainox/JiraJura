# === Python (backend) ===
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.env
.env.*
!.env.example

# === Node / Vite (frontend) ===
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# === Logs ===
logs/
*.log

# === Персональные данные сотрудников (списки для bulk_invite.py) ===
/rosters/
backend/rosters/
*roster*.xlsx
*result*.csv

# === Персональные данные (CSV-выгрузки reissue_invites.py и т.п.) ===
# НЕ backend/uploads/ — та раздаётся наружу без авторизации через
# /uploads/ (см. app/main.py StaticFiles + deploy/nginx/proxy.conf.template).
# exports/ не смонтирована никуда наружу.
/exports/
backend/exports/

# === Runtime uploads (user-generated content, not source) ===
# backend/uploads/* only matched the first level, so files inside
# subdirectories (e.g. backend/uploads/inspections/*.jpg) were never
# actually ignored -- confirmed live on the production checkout, which
# had hundreds of untracked real inspection photos sitting in `git
# status`. ** matches at every depth, which is what was actually meant.
backend/uploads/**
!backend/uploads/**/
!backend/uploads/**/.gitkeep

# === Deploy: generated/secret at runtime, not source ===
deploy/nginx/active.conf.template
deploy/certbot/conf/*
!deploy/certbot/conf/.gitkeep
deploy/certbot/www/*
!deploy/certbot/www/.gitkeep
/backups/

# === Editor / OS ===
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
