@pytest.fixture
def auth_headers(admin_user):
    """Хедеры с токеном админа."""
    from app.services.auth import create_access_token
    token = create_access_token(str(admin_user.id), admin_user.role)
    return {"Authorization": f"Bearer {token}"}


def make_scalar_result(value):
    """Создать результат для .scalar_one_or_none() / .scalars().all()."""
    m = MagicMock()
    if isinstance(value, list):
        m.scalars.return_value.all.return_value = value
    elif value is None:
        m.scalar_one_or_none.return_value = None
        m.scalar_one.return_value = None
    else:
        m.scalar_one_or_none.return_value = value
        m.scalar_one.return_value = value
    return m


def make_count_result(count: int):
    """Создать результат для count-запроса."""
    m = MagicMock()
    m.scalar_one.return_value = count
    return m
