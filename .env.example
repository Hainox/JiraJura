# Продакшн-конфигурация docker-compose.prod.yml. Скопируйте в .env на
# сервере (НЕ коммитить .env — уже в .gitignore) и заполните реальными
# значениями. Генерация секретов:
#   openssl rand -hex 32   -> SECRET_KEY
#   openssl rand -hex 24   -> POSTGRES_PASSWORD
#
# Значения ниже — под текущий прод (выделенный сервер obhod-sao.ru, см.
# deploy/README.md). Сценарий "сервер общий с Telegram-ботом"
# (journal.yuvibot2.xyz, нестандартные порты 8080/8443, BOT_COMPOSE_PROJECT/
# BOT_NGINX_SERVICE) больше не актуален — это архивная ветка, см. раздел
# «Архив» в конце deploy/README.md, если он когда-нибудь снова понадобится.

DOMAIN=obhod-sao.ru
CERTBOT_EMAIL=

SECRET_KEY=
POSTGRES_PASSWORD=

# Обычные 80/443 — сервер выделенный, ни с кем не делится портами.
# Сертификат — deploy/scripts/issue-cert-standalone.sh / renew-cert-standalone.sh
# (не issue-cert.sh/renew-cert.sh — те писаны под архивный сценарий с чужим
# nginx на порту 80, см. раздел «Архив» в deploy/README.md).
HTTP_PORT=80
HTTPS_PORT=443

# Оставить пустым: фронтенд и бэкенд отдаются с одного origin через proxy.
VITE_API_URL=
